# Public HTTPS endpoint (set STREAM_BASE_URL=https://iptv.example.com in .env)
https://iptv.example.com {
    # API: M3U / EPG / channels / health
    @api {
        host iptv.example.com
        path /playlist.m3u /epg.xml /channels /health
    }
    handle @api {
        reverse_proxy api:3000
    }

    # HLS stream segments on the same public domain
    handle /hls/* {
        reverse_proxy iptv:80
    }
}

# LAN fallback for clients without the public domain
http://<pi-lan-ip>:8081 {
    reverse_proxy api:3000
}
