# Copy to .env and adjust:  cp .env.example .env
PLAYLIST_USER=admin
PLAYLIST_PASS=changeme
# Public base URL for stream links in the generated M3U
# LAN-only: http://<pi-ip>:8080    |  With Caddy/TLS: https://iptv.example.com
STREAM_BASE_URL=http://<pi-ip>:8080
# Timezone for your region (IANA name, see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris
